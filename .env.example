PORT=3000

# Opcao 1: variaveis separadas (uso local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=validafifo
DB_USER=postgres
DB_PASSWORD=postgres

# Use true ao conectar em um banco PostgreSQL na nuvem que exige SSL (ex.: Render, Railway)
DB_SSL=false

# Opcao 2: uma unica URL de conexao (ex.: "External Database URL" do Render).
# Se DATABASE_URL estiver definida, ela tem prioridade sobre as variaveis DB_* acima.
# DATABASE_URL=postgresql://usuario:senha@host:5432/nomedobanco

# Chave secreta usada para assinar as sessoes de login. Use um valor longo e aleatorio.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se ficar vazia, o servidor gera uma temporaria e os usuarios sao deslogados a cada reinicio.
AUTH_SECRET=

# Opcional, apenas para demonstracao: com true o login nao e exigido (nenhum usuario e necessario).
# AUTH_DESATIVADA=true

# Opcional: usuario inicial criado/atualizado pelo "npm run db:init".
# Util em hospedagens sem terminal (ex.: plano gratuito do Render).
# ADMIN_NOME=Vania Marinelli
# ADMIN_EMAIL=vania@mercadocentral.com.br
# ADMIN_PASSWORD=troque-esta-senha
